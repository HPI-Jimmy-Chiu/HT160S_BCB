MAINICON ICON "HT160s.ico"

/* Version resource so the built ht160s.exe carries a usable VERSIONINFO block.
   NSIS !getdllversion in the updater (HT160_MUI.nsi) reads FILEVERSION below.
   Raw hex literals are used so no windows.h / winver.h include is required. */
1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Hon. Precision, Inc.\0"
            VALUE "FileDescription", "HT160S Series High Speed Logic Handler\0"
            VALUE "FileVersion", "1.0.0.0\0"
            VALUE "InternalName", "ht160s\0"
            VALUE "LegalCopyright", "(c) 2025 Hon. Precision, Inc.\0"
            VALUE "OriginalFilename", "ht160s.exe\0"
            VALUE "ProductName", "HT160S Series High Speed Logic Handler\0"
            VALUE "ProductVersion", "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

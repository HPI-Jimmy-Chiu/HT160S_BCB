VERSION = BCB.03
# ---------------------------------------------------------------------------
PROJECT = LngTst.exe
OBJFILES = LngTst.obj LangTest.obj
RESFILES = LngTst.res
DEFFILE =
RESDEPEN = $(RESFILES) LangTest.dfm
LIBFILES =
LIBRARIES = TEST.lib VCLDB35.lib bcbsmp35.lib vclx35.lib vcl35.lib
SPARELIBS = vcl35.lib vclx35.lib bcbsmp35.lib VCLDB35.lib TEST.lib
PACKAGES = VCLX35.bpi VCL35.bpi VCLDB35.bpi VCLDBX35.bpi dclocx35.bpi QRPT35.bpi \
  NMFAST35.bpi DSS35.bpi TEEUI35.bpi TEEDB35.bpi TEE35.bpi VCLMID35.bpi \
  INET35.bpi INETDB35.bpi bcbsmp35.bpi ibsmp35.bpi HkComp35.bpi Dclusr35.bpi \
  TEST.bpi
# ---------------------------------------------------------------------------
PATHCPP = .;
PATHASM = .;
PATHPAS = .;
PATHRC = .;
DEBUGLIBPATH = $(BCB)\lib\debug
RELEASELIBPATH = $(BCB)\lib\release
# ---------------------------------------------------------------------------
CFLAG1 = -Od -Hc -w- -Ve -r- -k -y -v -vi- -c -b- -w-par -w-inl -Vx
CFLAG2 = -D_RTLDLL \
  -I"..\..\program files\borland\cbuilder3\projects";"\\nt_server\source\bcb componet\component";"\\nt_server\source\bcb componet\calender";$(BCB)\include;$(BCB)\include\vcl \
  -H=$(BCB)\lib\vcl35.csm
CFLAG3 = -Tkh30000 -5
PFLAGS = -D_RTLDLL \
  -U..\packtest;"..\..\program files\borland\cbuilder3\projects";..\..\userpack;"\\nt_server\source\bcb componet\calender";"\\nt_server\source\bcb componet\component";$(BCB)\lib;$(BCB)\lib\obj;$(RELEASELIBPATH) \
  -I"..\..\program files\borland\cbuilder3\projects";"\\nt_server\source\bcb componet\component";"\\nt_server\source\bcb componet\calender";$(BCB)\include;$(BCB)\include\vcl \
  -$Y -$W -$V- -$O- -v -JPHN -M
RFLAGS = -D_RTLDLL \
  -i"..\..\program files\borland\cbuilder3\projects";"\\nt_server\source\bcb componet\component";"\\nt_server\source\bcb componet\calender";$(BCB)\include;$(BCB)\include\vcl
AFLAGS = /i"..\..\program files\borland\cbuilder3\projects" \
  /i"\\nt_server\source\bcb componet\component" /i"\\nt_server\source\bcb componet\calender" \
  /i$(BCB)\include /i$(BCB)\include\vcl /d_RTLDLL /mx /w2 /zi
LFLAGS = -L..\packtest;"..\..\program files\borland\cbuilder3\projects";..\..\userpack;"\\nt_server\source\bcb componet\calender";"\\nt_server\source\bcb componet\component";$(BCB)\lib;$(BCB)\lib\obj;$(RELEASELIBPATH) \
  -D"User Component" -aa -Tpe -x -Gn -Gl -Gi -w -v
IFLAGS =
# ---------------------------------------------------------------------------
ALLOBJ = c0w32.obj sysinit.obj $(OBJFILES)
ALLRES = $(RESFILES)
ALLLIB = $(LIBFILES) $(LIBRARIES) import32.lib cp32mti.lib
# ---------------------------------------------------------------------------
